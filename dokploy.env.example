# Dokploy Deployment Configuration
# ================================
#
# Option 1: Deploy with Docker Compose (Full Stack)
# - Upload docker-compose.dokploy.yml to Dokploy
# - Configure environment variables in Dokploy UI (or copy this file to your
#   Dokploy env and fill it in)
#
# Option 2: Deploy Server Only (Database external)
# - Deploy server/ folder as a Docker app in Dokploy
# - Use external PostgreSQL and Redis
# - Configure DATABASE_URL and REDIS_URL in Dokploy

# ---------------------------------------------------------------------------
# OBLIGATORIOS: el compose y el server revientan si faltan. No son opcionales,
# el server se niega a arrancar con secretos de ejemplo (o ausentes) en produccion.
# Genera cada secreto con:  openssl rand -hex 32   (minimo 16 caracteres)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR-password-alfanumerica-larga
POSTGRES_DB=remote_monitoring

# JWT Secrets
JWT_SECRET=REEMPLAZAR-openssl-rand-hex-32
JWT_REFRESH_SECRET=REEMPLAZAR-openssl-rand-hex-32-distinto
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Agent onboarding token (compartido, solo para dar de alta equipos).
# Rotarlo si estuvo en un repo publico: los agentes ya registrados conservan su token propio,
# pero cualquier equipo nuevo necesita este valor.
AGENT_REGISTRATION_TOKEN=REEMPLAZAR-openssl-rand-hex-32

# El refresh token va en cookie HttpOnly. Detras de HTTPS (Dokploy + LetsEncrypt) dejar true;
# solo false si el dominio sirve HTTP puro en una red aislada.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Cuantos proxies reenvían el request antes de llegar a Express (1 = nginx del contenedor).
TRUST_PROXY_HOPS=1

# Redis (use Dokploy Redis service or external)
# Nota: todavia no se usa el adapter de socket.io; hace falta solo si corras mas de una
# replica del server (y en ese caso instalá @socket.io/redis-adapter).
REDIS_URL=redis://redis:6379

# Server
PORT=3000
NODE_ENV=production

# CORS (your domain)
CORS_ORIGIN=https://your-domain.com

# Screenshots
SCREENSHOTS_DIR=./uploads/screenshots
MAX_SCREENSHOT_BYTES=12582912
WS_MAX_BUFFER_BYTES=16777216
DEVICE_OFFLINE_AFTER_MS=180000

# ---------------------------------------------------------------------------
# Bootstrap del admin (se corre en cada arranque del contenedor)
# ---------------------------------------------------------------------------
# Opcional. Si lo definís, esa tiene que ser la contraseña inicial del SUPER_ADMIN
# (minimo 12 caracteres). Si lo dejas vacío, el seed genera una aleatoria y la
# imprime UNA sola vez en el log del primer arranque: copiala de ahi.
#
# Despues del primer arranque el seed NO toca la contraseña: cambiarla desde el
# panel es permanente.
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Base de datos existente (solo la primera vez)
# ---------------------------------------------------------------------------
# Si la base se armó con `prisma db push` (sin tabla _prisma_migrations), el
# `prisma migrate deploy` del arranque falla con P3005 y el contenedor hace
# crash-loop. El entrypoint de la imagen combinada te deja baseliniar con esta
# variable, sin necesidad de terminal ni de `docker exec`:
#
#   1) descomentá la línea, redeployá una vez (log: "marco 20260810000000_init
#      como aplicada" y después "esquema OK"), 2) volvé a comentarla.
#
# Equivalente a mano, si preferís la terminal del contenedor:
#   docker exec -it <contenedor> npx prisma migrate resolve --applied 20260810000000_init
# PRISMA_BASELINE=1
