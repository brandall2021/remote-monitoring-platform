# ==== Base de datos ====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remote_monitoring"

# ==== Secretos ====
# JWT_SECRET, JWT_REFRESH_SECRET y AGENT_REGISTRATION_TOKEN son obligatorios en produccion:
# si faltan (o siguen siendo un valor de ejemplo), el proceso no arranca.
# Genera cada uno con:  openssl rand -hex 32
# Minimo 16 caracteres. En desarrollo, si no los pones, se usan secretos efimeros por proceso
# (los tokens dejan de valer al reiniciar; eso es intencional, no uses ese modo para publicar).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# Token compartido de onboarding: solo sirve para dar de alta equipos. Cada dispositivo recibe
# despues su propio token unico, que es el que usa el agente para conectarse por WebSocket.
AGENT_REGISTRATION_TOKEN=""

# ==== Auth ====
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# El refresh token viaja en una cookie HttpOnly, no en el JSON de la respuesta.
# COOKIE_SECURE=true exige HTTPS; dejalo en false solo en http://localhost.
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
REFRESH_COOKIE_NAME="rm_refresh"

# ==== Servidor ====
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
# Cuantos proxies hay delante de Express. 1 = nginx del mismo contenedor.
# Sin esto req.ip siempre es 127.0.0.1 y los rate limits de login se comparten entre todos.
TRUST_PROXY_HOPS=1

# ==== WebSocket / agentes ====
# Tamano maximo de un mensaje (frame de live view). Con el cuadro escalado a 1280 px son ~100 KB;
# 16 MB es el margen para agentes viejos que aun mandan el JPEG nativo.
WS_MAX_BUFFER_BYTES=16777216
# Keepalive. No bajar el timeout de 20 s: mientras corre la vista en vivo el uplink del agente esta
# ocupado y un pong que tarda 6 s cerraba la conexion (el equipo aparecia OFFLINE a los saltos).
WS_PING_INTERVAL_MS=25000
WS_PING_TIMEOUT_MS=20000
# Heartbeat del agente cada 30 s: 2 minutos de tolerancia antes de marcar OFFLINE.
DEVICE_OFFLINE_AFTER_MS=180000

# ==== Capturas ====
SCREENSHOTS_DIR="./uploads/screenshots"
MAX_SCREENSHOT_BYTES=12582912

# ==== Seed inicial (bootstrap del contenedor) ====
# Opcional. Si no se define, la primera vez que existe la base se genera una contrasena aleatoria
# y se imprime UNA sola vez en los logs del arranque.
# despues de ese primer arranque el seed nunca pisa la contrasena del admin.
# Minimo 12 caracteres.
SEED_ADMIN_PASSWORD=""

# ==== Redis ====
# El server conecta pero todavia no se usa el adapter de socket.io: con una sola instancia
# de server esta sobrando. Para escalar a N replicas hace falta instalar @socket.io/redis-adapter.
REDIS_URL="redis://localhost:6379"
