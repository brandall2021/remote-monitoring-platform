SERVER_URL=http://localhost:3000
DEVICE_ID=
REGISTRATION_TOKEN=
AGENT_VERSION=1.1.0
HEARTBEAT_INTERVAL=30000

# Vista en vivo: cada cuadro se captura escalado a este ancho (px) y comprimido con esta calidad
# JPEG. 1280/70 deja el frame en ~60 KB; a resolucion nativa son varios MB y el uplink se colapsa.
# Validos: LIVE_MAX_WIDTH 320-3840, LIVE_JPEG_QUALITY 30-95.
LIVE_MAX_WIDTH=1280
LIVE_JPEG_QUALITY=70

# Worker de captura persistente: mientras hay espectadores el agente levanta UN powershell.exe y le
# pide cuadros por stdin (~170 ms por cuadro). Con 0 se vuelve a la ruta vieja, que levanta un
# powershell.exe nuevo por cuadro (~1400 ms) o re-encodifica en JavaScript (~720 ms).
LIVE_CAPTURE_WORKER=1

# Techo de tamano de un cuadro, en bytes. Un JPEG de 1280 px pesa ~60 KB; si el worker manda algo de
# este orden de magnitud es que el canal de cuadros se rompio, y el cuadro se descarta.
# Validos: 65536-33554432 (el server descarta lo que pase de WS_MAX_BUFFER_BYTES).
LIVE_MAX_FRAME_BYTES=8388608
